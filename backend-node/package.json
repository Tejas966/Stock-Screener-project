{
  "name": "fundamentalx-backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "FundamentalX API gateway (Node.js + Express)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/",
    "build:demo-data": "node scripts/build-demo-data.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "db:reset": "node scripts/db-migrate.js --reset && node scripts/db-seed.js"
  },
  "dependencies": {
    "@google/genai": "2.25.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "supertest": "7.3.0"
  }
}
