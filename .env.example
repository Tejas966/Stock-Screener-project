# FundamentalX - shared backend configuration.
# Copy to ".env" in the project root and fill in values. NEVER commit .env.
# The React frontend does NOT read this file (see frontend/.env.example).

# ---------------------------------------------------------------- general
NODE_ENV=development
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Node gateway
NODE_PORT=4000
# Session lifetime in hours (server-side sessions, httpOnly cookie)
SESSION_TTL_HOURS=72
# Set true when serving over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# ---------------------------------------------------------------- MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fundamentalx
DB_USER=fundamentalx
DB_PASSWORD=change-me-local-password
# Separate database used by the automated PHP / Node DB tests (gets wiped)
DB_TEST_NAME=fundamentalx_test

# ---------------------------------------------------------------- internal services
PYTHON_SERVICE_URL=http://127.0.0.1:8001
PHP_SERVICE_URL=http://127.0.0.1:8002
# Shared secrets for service-to-service calls (min 16 chars, random). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHP_SERVICE_SECRET=replace-with-a-long-random-string
PYTHON_SERVICE_SECRET=replace-with-another-long-random-string
SERVICE_TIMEOUT_MS=5000

# ---------------------------------------------------------------- financial data provider
# "demo" = bundled ILLUSTRATIVE dataset (no key needed, clearly labelled in the UI)
# "fmp"  = Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs)
FINANCIAL_PROVIDER=demo
FINANCIAL_PROVIDER_API_KEY=
FINANCIAL_PROVIDER_BASE_URL=https://financialmodelingprep.com/stable
PROVIDER_TIMEOUT_MS=8000
SUPPORTED_EXCHANGES=NSE,BSE
# Cache lifetimes (seconds) - different data changes at different speeds
CACHE_TTL_QUOTE_SECONDS=900
CACHE_TTL_HISTORY_SECONDS=43200
CACHE_TTL_STATEMENTS_SECONDS=86400

# ---------------------------------------------------------------- Gemini (server-side only!)
GEMINI_API_KEY=
# Confirm the current model id at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
# Max AI explanation requests per user per hour
AI_RATE_LIMIT_PER_HOUR=20
